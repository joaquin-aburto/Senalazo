  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Se\xF1alazo es un videojuego innovador que reimagina la tradicional loter\xEDa
    mexicana, integrando tecnolog\xEDa de vanguardia con un enfoque profundamente
    humano y educativo. Este proyecto \xFAnico tiene como objetivo principal fomentar
    la inclusi\xF3n social y el aprendizaje del lenguaje de se\xF1as mexicano, todo
    dentro de una experiencia interactiva, divertida y accesible para personas de
    todas las edades.\n\nA trav\xE9s del uso de un guante inteligente, dise\xF1ado
    para detectar y traducir movimientos en tiempo real, los jugadores pueden comunicarse
    utilizando se\xF1as mientras participan en din\xE1micas inspiradas en la loter\xEDa.
    Esta herramienta no solo hace posible que personas oyentes y no oyentes jueguen
    juntas en igualdad de condiciones, sino que tambi\xE9n se convierte en una poderosa
    v\xEDa de aprendizaje, sensibilizaci\xF3n y empat\xEDa.\n\nSe\xF1alazo rompe
    barreras de comunicaci\xF3n, promueve el respeto hacia la comunidad sorda, y
    transforma el acto de jugar en una oportunidad para educar y unir. Cada partida
    se convierte en un espacio donde la inclusi\xF3n cobra vida, donde el lenguaje
    de se\xF1as deja de ser un misterio y se convierte en un puente entre mundos
    distintos.\n\nM\xE1s que un simple videojuego, Se\xF1alazo es un movimiento por
    la igualdad, la diversidad y la educaci\xF3n accesible, demostrando que la tecnolog\xEDa,
    cuando se usa con prop\xF3sito, puede cambiar vidas y abrir puertas donde antes
    solo hab\xEDa muros."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
